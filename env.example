# ---- Optional: smart AI analysis (Gemini). Without a key, the built-in rule checker is used. ----
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---- Accounts and admin ----
# Long random text used to sign login tokens (at least 16 characters). REQUIRED in production,
# otherwise everybody is signed out each time the server restarts.
AUTH_SECRET="change-this-to-a-long-random-text"

# The first administrator account is created automatically from these two values (password: 8+ characters).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# ---- Optional settings ----
# Live company checks (does the domain exist, how old is it). Set to false to turn them off.
# COMPANY_VERIFY_ONLINE=true
# Maximum checks per minute from one address (default 60).
# RATE_LIMIT_PER_MIN=60
# Maximum new accounts per hour from one address (default 10).
# REGISTER_LIMIT_PER_HOUR=10
